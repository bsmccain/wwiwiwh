{
  "name": "wwiwiwh",
  "private": true,
  "version": "0.3.0-alpha",
  "description": "Lay the street map of a place you know over another place at the same scale.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "WWIWIWH_LIVE=1 playwright test --grep @live",
    "inks": "vitest run src/styles/ink-sets.test.ts -u",
    "shot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "maplibre-gl": "^6.17.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.6.0",
    "@playwright/test": "~1.63.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
